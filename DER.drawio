        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nhide circle\nhide empty methods\nhide empty fields\n\n&#39; Evitar que los dobles dos puntos se interpreten como namespaces\nset namespaceSeparator none\n\n&#39; Trazado ortogonal de conectores\nskinparam linetype ortho\nskinparam roundcorner 5\nskinparam shadowing false\nskinparam handwritten false\n\n&#39; Tipografía\nskinparam defaultFontName \&quot;Segoe UI\&quot;, Tahoma, Arial, sans-serif\nskinparam defaultFontSize 11\n\n&#39; Estilo visual de entidades (tablas)\nskinparam entity {\n    BackgroundColor #FFFFFF\n    BorderColor #2B579A\n    HeaderBackgroundColor #E8EEF5\n    FontColor #000000\n    FontSize 12\n    FontStyle bold\n    BorderThickness 1.2\n}\n\n&#39; Estilo visual de relaciones\nskinparam arrow {\n    Color #2B579A\n    Thickness 1.2\n    FontColor #1F497D\n    FontSize 11\n    FontStyle bold\n}\n\n&#39; ========================================================\n&#39; TABLAS DE LA BASE DE DATOS\n&#39; ========================================================\n\nentity \&quot;TipoHabitacion\&quot; as TipoHabitacion {\n    IdTipoHabitacion : int &lt;&lt;PK&gt;&gt;\n    --\n    Descripcion : varchar(50)\n    Capacidad : int\n    PrecioPorNoche : decimal(10,2)\n    Activo : bit\n}\n\nentity \&quot;TipoHabitacion_C\&quot; as TipoHabitacion_C {\n    IdTipoHabitacion : int &lt;&lt;FK&gt;&gt;\n    Fecha : date\n    Hora : time(0)\n    --\n    Descripcion : nvarchar(100)\n    Capacidad : int\n    Precio : decimal(10,2)\n    Activo : bit\n    Actual : bit\n}\n\nentity \&quot;Habitacion\&quot; as Habitacion {\n    IdHabitacion : int &lt;&lt;PK&gt;&gt;\n    --\n    IdTipoHabitacion : int &lt;&lt;FK&gt;&gt;\n    Numero : int &lt;&lt;UQ&gt;&gt;\n    Descripcion : varchar(100)\n    Estado : varchar(20)\n    Activo : bit\n}\n\nentity \&quot;Huesped\&quot; as Huesped {\n    IdHuesped : int &lt;&lt;PK&gt;&gt;\n    --\n    Dni : varchar(10) &lt;&lt;UQ&gt;&gt;\n    Nombre : varchar(50)\n    Apellido : varchar(50)\n    FechaNacimiento : date\n    CorreoElectronico : varchar(100)\n    Telefono : varchar(20)\n    Activo : bit\n}\n\nentity \&quot;Reserva\&quot; as Reserva {\n    IdReserva : int &lt;&lt;PK&gt;&gt;\n    --\n    IdHabitacion : int &lt;&lt;FK&gt;&gt;\n    IdHuesped : int &lt;&lt;FK&gt;&gt;\n    FechaCheckIn : date\n    FechaCheckOut : date\n    CantidadPersonas : int\n    Estado : varchar(20)\n    FechaAlta : datetime\n}\n\nentity \&quot;Pago\&quot; as Pago {\n    IdPago : int &lt;&lt;PK&gt;&gt;\n    --\n    IdReserva : int &lt;&lt;FK&gt;&gt;\n    MetodoPago : varchar(20)\n    Monto : decimal(10,2)\n    FechaPago : datetime\n}\n\nentity \&quot;TipoServicio\&quot; as TipoServicio {\n    IdTipoServicio : int &lt;&lt;PK&gt;&gt;\n    --\n    Descripcion : varchar(100)\n    Precio : decimal(10,2)\n    RequiereStaff : bit\n    Activo : bit\n}\n\nentity \&quot;SolicitudServicio\&quot; as SolicitudServicio {\n    IdSolicitud : int &lt;&lt;PK&gt;&gt;\n    --\n    IdReserva : int &lt;&lt;FK&gt;&gt;\n    IdTipoServicio : int &lt;&lt;FK&gt;&gt;\n    FechaHoraSolicitud : datetime\n    Precio : decimal(10,2)\n    EstadoServicio : varchar(20)\n    EstadoPago : varchar(20)\n    MetodoPago : varchar(20)\n}\n\nentity \&quot;USUARIO_64PR\&quot; as USUARIO_64PR {\n    DNI : nvarchar(20) &lt;&lt;PK&gt;&gt;\n    --\n    Rol : int &lt;&lt;FK&gt;&gt;\n    Login : nvarchar(50) &lt;&lt;UQ&gt;&gt;\n    Email : nvarchar(256) &lt;&lt;UQ&gt;&gt;\n    Nombre : nvarchar(100)\n    Apellido : nvarchar(100)\n    Contrasena : varbinary(48)\n    Bloqueo : bit\n    Activo : bit\n    Intentos : int\n    PrimeraVez : bit\n    Idioma : varchar(5)\n}\n\nentity \&quot;Roles_64PR\&quot; as Roles_64PR {\n    ID_Rol : int &lt;&lt;PK&gt;&gt;\n    --\n    Nombre : varchar(100)\n}\n\nentity \&quot;Patente_64PR\&quot; as Patente_64PR {\n    ID_Patente : int &lt;&lt;PK&gt;&gt;\n    --\n    Nombre : varchar(100)\n}\n\nentity \&quot;Familia_64PR\&quot; as Familia_64PR {\n    ID_Familia : int &lt;&lt;PK&gt;&gt;\n    --\n    Nombre : varchar(100)\n}\n\nentity \&quot;RolPatente_64PR\&quot; as RolPatente_64PR {\n    ID_Rol : int &lt;&lt;PK, FK&gt;&gt;\n    ID_Patente : int &lt;&lt;PK, FK&gt;&gt;\n    --\n}\n\nentity \&quot;RolFamilia_64PR\&quot; as RolFamilia_64PR {\n    ID_Rol : int &lt;&lt;PK, FK&gt;&gt;\n    ID_Familia : int &lt;&lt;PK, FK&gt;&gt;\n    --\n}\n\nentity \&quot;PatenteFamilia_64PR\&quot; as PatenteFamilia_64PR {\n    ID_Familia : int &lt;&lt;PK, FK&gt;&gt;\n    ID_Patente : int &lt;&lt;PK, FK&gt;&gt;\n    --\n}\n\nentity \&quot;Familia_N_64PR\&quot; as Familia_N_64PR {\n    ID_FamiliaPadre : int &lt;&lt;PK, FK&gt;&gt;\n    ID_FamiliaHija : int &lt;&lt;PK, FK&gt;&gt;\n    --\n}\n\nentity \&quot;Evento_64PR\&quot; as Evento_64PR {\n    Id_evento : int &lt;&lt;PK&gt;&gt;\n    --\n    Login : nvarchar(50) &lt;&lt;FK&gt;&gt;\n    Id_modulo : int &lt;&lt;FK&gt;&gt;\n    Id_Tipo : int &lt;&lt;FK&gt;&gt;\n    Fecha : date\n    Hora : time(7)\n    criticidad : tinyint\n}\n\nentity \&quot;TipoEvento_64PR\&quot; as TipoEvento_64PR {\n    Id_tipo : int &lt;&lt;PK&gt;&gt;\n    --\n    Nombre : varchar(100)\n}\n\nentity \&quot;Modulo_64PR\&quot; as Modulo_64PR {\n    Id_modulo : int &lt;&lt;PK&gt;&gt;\n    --\n    Nombre : nvarchar(50) &lt;&lt;UQ&gt;&gt;\n}\n\nentity \&quot;DV_64PR\&quot; as DV_64PR {\n    Tabla : nvarchar(100) &lt;&lt;PK&gt;&gt;\n    --\n    DV : bigint\n}\n\nentity \&quot;DVH_64PR\&quot; as DVH_64PR {\n    Tabla : nvarchar(100) &lt;&lt;PK&gt;&gt;\n    IdFila : nvarchar(100) &lt;&lt;PK&gt;&gt;\n    --\n    DVH : bigint\n}\n\n&#39; ========================================================\n&#39; CONEXIONES (NOTACIÓN \&quot;1\&quot; A \&quot;n\&quot;, SIN PATA DE GALLO)\n&#39; APUNTANDO EXACTAMENTE DE PK A FK\n&#39; ========================================================\n\nTipoHabitacion::IdTipoHabitacion \&quot;1\&quot; --&gt; \&quot;n\&quot; Habitacion::IdTipoHabitacion\nHabitacion::IdHabitacion \&quot;1\&quot; --&gt; \&quot;n\&quot; Reserva::IdHabitacion\nHuesped::IdHuesped \&quot;1\&quot; --&gt; \&quot;n\&quot; Reserva::IdHuesped\nReserva::IdReserva \&quot;1\&quot; --&gt; \&quot;n\&quot; Pago::IdReserva\nReserva::IdReserva \&quot;1\&quot; --&gt; \&quot;n\&quot; SolicitudServicio::IdReserva\nTipoServicio::IdTipoServicio \&quot;1\&quot; --&gt; \&quot;n\&quot; SolicitudServicio::IdTipoServicio\nTipoHabitacion::IdTipoHabitacion \&quot;1\&quot; ..&gt; \&quot;n\&quot; TipoHabitacion_C::IdTipoHabitacion\n\nRoles_64PR::ID_Rol \&quot;1\&quot; --&gt; \&quot;n\&quot; USUARIO_64PR::Rol\nRoles_64PR::ID_Rol \&quot;1\&quot; --&gt; \&quot;n\&quot; RolPatente_64PR::ID_Rol\nPatente_64PR::ID_Patente \&quot;1\&quot; --&gt; \&quot;n\&quot; RolPatente_64PR::ID_Patente\nRoles_64PR::ID_Rol \&quot;1\&quot; --&gt; \&quot;n\&quot; RolFamilia_64PR::ID_Rol\nFamilia_64PR::ID_Familia \&quot;1\&quot; --&gt; \&quot;n\&quot; RolFamilia_64PR::ID_Familia\nFamilia_64PR::ID_Familia \&quot;1\&quot; --&gt; \&quot;n\&quot; PatenteFamilia_64PR::ID_Familia\nPatente_64PR::ID_Patente \&quot;1\&quot; --&gt; \&quot;n\&quot; PatenteFamilia_64PR::ID_Patente\nFamilia_64PR::ID_Familia \&quot;1\&quot; --&gt; \&quot;n\&quot; Familia_N_64PR::ID_FamiliaPadre\nFamilia_64PR::ID_Familia \&quot;1\&quot; --&gt; \&quot;n\&quot; Familia_N_64PR::ID_FamiliaHija\n\nUSUARIO_64PR::Login \&quot;1\&quot; --&gt; \&quot;n\&quot; Evento_64PR::Login\nModulo_64PR::Id_modulo \&quot;1\&quot; --&gt; \&quot;n\&quot; Evento_64PR::Id_modulo\nTipoEvento_64PR::Id_tipo \&quot;1\&quot; --&gt; \&quot;n\&quot; Evento_64PR::Id_Tipo\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fAhVfHV8-qFRMvpL7HX2-200">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
